FROM node:20-alpine AS build

WORKDIR /usr/src/app

ARG VITE_GOOGLE_CLIENT_ID
ARG GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_ALLOWED_ORIGINS
ARG VITE_API_URL=""
ARG GIT_SHA=unknown

ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_ALLOWED_ORIGINS=$VITE_GOOGLE_ALLOWED_ORIGINS
ENV VITE_API_URL=$VITE_API_URL

COPY frontend/package*.json ./
RUN npm ci

COPY frontend .
COPY updates/version.txt ./.g3-version

RUN if [ -z "$VITE_GOOGLE_CLIENT_ID" ] && [ -n "$GOOGLE_CLIENT_ID" ]; then export VITE_GOOGLE_CLIENT_ID="$GOOGLE_CLIENT_ID"; fi; npm run build

FROM nginx:1.27-alpine

RUN apk add --no-cache python3 wget gettext

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /usr/src/app/dist/ /usr/share/nginx/html/
RUN printf '{"commit":"%s"}\n' "$GIT_SHA" > /usr/share/nginx/html/build-info.json
COPY frontend/env-config.js /usr/share/nginx/html/env-config.js
COPY frontend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
