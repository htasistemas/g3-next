{
  "name": "frontend",
  "version": "1.00.14",
  "scripts": {
    "start": "npm run dev",
    "check:ptbr": "node ./scripts/check-ptbr-encoding.cjs",
    "predev": "npm run check:ptbr",
    "dev": "vite --config vite.react.config.ts --host 0.0.0.0 --port 5173",
    "build": "npm run react:build",
    "watch": "vite build --config vite.react.config.ts --watch",
    "test": "npm run react:typecheck && npm run test:text",
    "react:dev": "vite --config vite.react.config.ts --host 0.0.0.0 --port 5173",
    "prereact:build": "npm run check:ptbr",
    "react:build": "vite build --config vite.react.config.ts",
    "react:preview": "vite preview --config vite.react.config.ts",
    "react:typecheck": "tsc -p tsconfig.react.json --noEmit",
    "test:text": "vitest run src/lib/__tests__"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.1.0",
    "@fortawesome/free-brands-svg-icons": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "7.1.0",
    "@hookform/resolvers": "5.0.1",
    "@radix-ui/react-slot": "1.2.3",
    "@stomp/stompjs": "7.0.1",
    "@tanstack/react-query": "5.74.4",
    "@types/jsbarcode": "3.11.4",
    "@types/qrcode": "1.5.6",
    "axios": "1.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsbarcode": "3.12.3",
    "leaflet": "1.9.4",
    "lucide-react": "0.507.0",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.56.1",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.13.2",
    "recharts": "3.0.2",
    "sockjs-client": "1.6.1",
    "tailwind-merge": "3.3.0",
    "tslib": "2.3.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/sockjs-client": "1.5.4",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.22",
    "baseline-browser-mapping": "2.10.0",
    "immutable": "5.1.5",
    "jsdom": "27.1.0",
    "postcss": "8.5.6",
    "rollup": "4.59.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.9.2",
    "vite": "6.4.1",
    "vitest": "4.0.8"
  }
}
