{
  "name": "frontend",
  "version": "1.00.12",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "predev": "node ./scripts/ensure-deps.cjs",
    "dev": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "react:dev": "vite --config vite.react.config.ts --host 0.0.0.0 --port 5173",
    "react:build": "vite build --config vite.react.config.ts",
    "react:preview": "vite preview --config vite.react.config.ts",
    "react:typecheck": "tsc -p tsconfig.react.json --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.74.4",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@stomp/stompjs": "^7.0.1",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.507.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "react-router-dom": "^7.6.1",
    "recharts": "^3.0.2",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.3.0",
    "tslib": "^2.3.0",
    "zod": "^3.24.4",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@types/sockjs-client": "^1.5.4",
    "autoprefixer": "^10.4.22",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^4.0.8"
  }
}
