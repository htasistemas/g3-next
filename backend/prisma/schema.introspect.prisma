}

model prontuario_registros {
  id                                                     BigInt                  @id @default(autoincrement())
  beneficiario_id                                        BigInt
  tipo                                                   String                  @db.VarChar(40)
  data_registro                                          DateTime                @db.Timestamp(6)
  profissional_id                                        BigInt?
  unidade_id                                             BigInt?
  titulo                                                 String?                 @db.VarChar(200)
  descricao                                              String
  dados_extra                                            Json?
  status                                                 String                  @default("aberto") @db.VarChar(20)
  criado_em                                              DateTime                @default(now()) @db.Timestamp(6)
  criado_por                                             BigInt?
  atualizado_em                                          DateTime                @default(now()) @db.Timestamp(6)
  atualizado_por                                         BigInt?
  familia_id                                             BigInt?
  referencia_origem_tipo                                 String?                 @db.VarChar(40)
  referencia_origem_id                                   BigInt?
  nivel_sigilo                                           String?                 @db.VarChar(30)
  prontuario_anexos                                      prontuario_anexos[]
  usuarios_prontuario_registros_atualizado_porTousuarios Usuario?                @relation("prontuario_registros_atualizado_porTousuarios", fields: [atualizado_por], references: [id], onUpdate: NoAction)
  cadastro_beneficiario                                  CadastroBeneficiario    @relation(fields: [beneficiario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios_prontuario_registros_criado_porTousuarios     Usuario?                @relation("prontuario_registros_criado_porTousuarios", fields: [criado_por], references: [id], onUpdate: NoAction)
  vinculo_familiar                                       VinculoFamiliar?        @relation(fields: [familia_id], references: [id], onUpdate: NoAction)
  cadastro_profissionais                                 cadastro_profissionais? @relation(fields: [profissional_id], references: [id], onUpdate: NoAction)
  unidade_assistencial                                   UnidadeAssistencial?    @relation(fields: [unidade_id], references: [id], onUpdate: NoAction)

  @@index([beneficiario_id, data_registro(sort: Desc)], map: "prontuario_registros_beneficiario_data_idx")
  @@index([familia_id], map: "prontuario_registros_familia_idx")
  @@index([profissional_id], map: "prontuario_registros_profissional_idx")
  @@index([tipo])
}

