  almoxarifado_item_produtos_kit_composicao_produto_kit_idToalmoxarifado_item  almoxarifado_item @relation("produtos_kit_composicao_produto_kit_idToalmoxarifado_item", fields: [produto_kit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

