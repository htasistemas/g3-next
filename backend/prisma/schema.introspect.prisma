  usuarios             Usuario?             @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([data_hora_chamada(sort: Desc)], map: "senha_chamada_data_idx")
  @@index([unidade_id], map: "senha_chamada_unidade_idx")
