  horario_domingo_entrada_1                                                 DateTime?                           @db.Time(6)
  horario_domingo_saida_1                                                   DateTime?                           @db.Time(6)
  horario_domingo_entrada_2                                                 DateTime?                           @db.Time(6)
  horario_domingo_saida_2                                                   DateTime?                           @db.Time(6)
  auditoria_evento                                                          auditoria_evento[]
  biblioteca_emprestimos                                                    biblioteca_emprestimos[]
  chamado_tecnico_chamado_tecnico_criado_por_usuario_idTousuarios           chamado_tecnico[]                   @relation("chamado_tecnico_criado_por_usuario_idTousuarios")
  chamado_tecnico_chamado_tecnico_respondido_por_usuario_idTousuarios       chamado_tecnico[]                   @relation("chamado_tecnico_respondido_por_usuario_idTousuarios")
  chamado_tecnico_chamado_tecnico_responsavel_usuario_idTousuarios          chamado_tecnico[]                   @relation("chamado_tecnico_responsavel_usuario_idTousuarios")
  chamado_tecnico_acao_chamado_tecnico_acao_criado_por_usuario_idTousuarios chamado_tecnico_acao[]              @relation("chamado_tecnico_acao_criado_por_usuario_idTousuarios")
  chamado_tecnico_acao_chamado_tecnico_acao_de_responsavel_idTousuarios     chamado_tecnico_acao[]              @relation("chamado_tecnico_acao_de_responsavel_idTousuarios")
