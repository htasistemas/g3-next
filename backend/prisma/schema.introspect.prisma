  descricao_tela              String?              @db.VarChar(200)
  atualizado_em               DateTime             @db.Timestamp(6)
  quantidade_ultimas_chamadas Int                  @default(4)
  unidade_painel_id           BigInt?
  modo_noticias               String?              @db.VarChar(20)
  noticias_manuais            String?
