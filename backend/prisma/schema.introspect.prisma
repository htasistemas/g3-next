model rh_termo {
  id                      BigInt                  @id @default(autoincrement())
  processo_id             BigInt
  tipo                    String                  @db.VarChar(40)
  dados_json              String?
  status_assinatura       String?                 @db.VarChar(30)
  data_assinatura         DateTime?               @db.Date
  responsavel             String?                 @db.VarChar(120)
  criado_em               DateTime                @default(now()) @db.Timestamp(6)
  atualizado_em           DateTime                @default(now()) @db.Timestamp(6)
  rh_processo_contratacao rh_processo_contratacao @relation(fields: [processo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([processo_id, tipo], map: "rh_termo_unique")
}

model salas_unidade {
