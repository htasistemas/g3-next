model visita_domiciliar {
  id                         BigInt                    @id @default(autoincrement())
  beneficiario_id            BigInt
  unidade                    String                    @db.VarChar(200)
  responsavel                String                    @db.VarChar(150)
  data_visita                DateTime                  @db.Date
  horario_inicial            DateTime                  @db.Time(6)
  horario_final              DateTime?                 @db.Time(6)
  tipo_visita                String?                   @db.VarChar(80)
