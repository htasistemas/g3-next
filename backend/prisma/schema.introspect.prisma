  unidade_assistencial UnidadeAssistencial   @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model senha_chamada {
  id                   String               @id @db.Uuid
  fila_id              BigInt
  nome_beneficiario    String               @db.VarChar(200)
  local_atendimento    String               @db.VarChar(120)
  status               String               @db.VarChar(20)
  data_hora_chamada    DateTime             @db.Timestamp(6)
  data_hora_criacao    DateTime             @db.Timestamp(6)
  chamado_por          String               @db.VarChar(120)
  unidade_id           BigInt?
  usuario_id           BigInt?
