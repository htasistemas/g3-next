  numero_patrimonio       String                    @db.VarChar(60)
  nome                    String                    @db.VarChar(200)
  categoria               String?                   @db.VarChar(120)
  subcategoria            String?                   @db.VarChar(120)
  conservacao             String?                   @db.VarChar(60)
  status                  String?                   @db.VarChar(60)
  data_aquisicao          DateTime?                 @db.Date
  valor_aquisicao         Decimal?                  @db.Decimal(14, 2)
  origem                  String?                   @db.VarChar(120)
  responsavel             String?                   @db.VarChar(150)
  unidade                 String?                   @db.VarChar(120)
  sala                    String?                   @db.VarChar(120)
  taxa_depreciacao        Decimal?                  @db.Decimal(5, 2)
  observacoes             String?
  criado_em               DateTime                  @default(now()) @db.Timestamp(6)
  atualizado_em           DateTime                  @default(now()) @db.Timestamp(6)
  doacao_id               BigInt?
  patrimonio_movimentacao patrimonio_movimentacao[]
}

model patrimonio_movimentacao {
  id              BigInt          @id @default(autoincrement())
  patrimonio_id   BigInt
  tipo            String          @db.VarChar(30)
  destino         String?         @db.VarChar(150)
  responsavel     String?         @db.VarChar(150)
  observacao      String?
  data_movimento  DateTime        @db.Date
  criado_em       DateTime        @default(now()) @db.Timestamp(6)
  patrimonio_item patrimonio_item @relation(fields: [patrimonio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model plano_trabalho {
  id                        BigInt                      @id @default(autoincrement())
  codigo_interno            String                      @db.VarChar(40)
  titulo                    String                      @db.VarChar(200)
  descricao_geral           String
  status                    String                      @db.VarChar(20)
  orgao_concedente          String?                     @db.VarChar(40)
  orgao_outro_descricao     String?                     @db.VarChar(200)
  area_programa             String?                     @db.VarChar(120)
  data_elaboracao           DateTime?                   @db.Date
  data_aprovacao            DateTime?                   @db.Date
  vigencia_inicio           DateTime?                   @db.Date
  vigencia_fim              DateTime?                   @db.Date
  termo_fomento_id          BigInt
  numero_processo           String?                     @db.VarChar(120)
  modalidade                String?                     @db.VarChar(120)
  observacoes_vinculacao    String?
  arquivo_formato           String?                     @db.VarChar(20)
  criado_em                 DateTime                    @default(now()) @db.Timestamp(6)
  atualizado_em             DateTime                    @default(now()) @db.Timestamp(6)
  termo_fomento             termo_fomento               @relation(fields: [termo_fomento_id], references: [id], onUpdate: NoAction)
  plano_trabalho_cronograma plano_trabalho_cronograma[]
  plano_trabalho_equipe     plano_trabalho_equipe[]
  plano_trabalho_metas      plano_trabalho_metas[]

  @@index([status])
  @@index([termo_fomento_id], map: "plano_trabalho_termo_idx")
}

model plano_trabalho_atividades {
  id                    BigInt                  @id @default(autoincrement())
  meta_id               BigInt
  descricao             String
  justificativa         String?
  publico_alvo          String?
  local_execucao        String?
  produto_esperado      String?
  criado_em             DateTime                @default(now()) @db.Timestamp(6)
  plano_trabalho_metas  plano_trabalho_metas    @relation(fields: [meta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plano_trabalho_etapas plano_trabalho_etapas[]

  @@index([meta_id], map: "plano_trabalho_atividades_meta_idx")
}

model plano_trabalho_cronograma {
  id                   BigInt         @id @default(autoincrement())
  plano_trabalho_id    BigInt
  referencia_tipo      String?        @db.VarChar(40)
  referencia_id        String?        @db.VarChar(40)
  referencia_descricao String?
  competencia          String         @db.VarChar(20)
  descricao_resumida   String?
  valor_previsto       Decimal?       @db.Decimal(14, 2)
  fonte_recurso        String?        @db.VarChar(60)
  natureza_despesa     String?        @db.VarChar(120)
  observacoes          String?
  criado_em            DateTime       @default(now()) @db.Timestamp(6)
  plano_trabalho       plano_trabalho @relation(fields: [plano_trabalho_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plano_trabalho_id], map: "plano_trabalho_cronograma_plano_idx")
}

model plano_trabalho_equipe {
  id                BigInt         @id @default(autoincrement())
  plano_trabalho_id BigInt
  nome              String         @db.VarChar(200)
  funcao            String?        @db.VarChar(200)
  cpf               String?        @db.VarChar(20)
  carga_horaria     String?        @db.VarChar(80)
  tipo_vinculo      String?        @db.VarChar(120)
  contato           String?        @db.VarChar(200)
  criado_em         DateTime       @default(now()) @db.Timestamp(6)
  plano_trabalho    plano_trabalho @relation(fields: [plano_trabalho_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plano_trabalho_id], map: "plano_trabalho_equipe_plano_idx")
}

model plano_trabalho_etapas {
  id                        BigInt                    @id @default(autoincrement())
  atividade_id              BigInt
  descricao                 String
  status                    String?                   @db.VarChar(30)
  data_inicio_prevista      DateTime?                 @db.Date
  data_fim_prevista         DateTime?                 @db.Date
  data_conclusao            DateTime?                 @db.Date
  responsavel               String?                   @db.VarChar(200)
  criado_em                 DateTime                  @default(now()) @db.Timestamp(6)
  plano_trabalho_atividades plano_trabalho_atividades @relation(fields: [atividade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([atividade_id], map: "plano_trabalho_etapas_atividade_idx")
}

model plano_trabalho_metas {
  id                        BigInt                      @id @default(autoincrement())
  plano_trabalho_id         BigInt
  codigo                    String?                     @db.VarChar(60)
  descricao                 String
  indicador                 String?
  unidade_medida            String?                     @db.VarChar(60)
  quantidade_prevista       Decimal?                    @db.Decimal(14, 2)
  resultado_esperado        String?
  criado_em                 DateTime                    @default(now()) @db.Timestamp(6)
  plano_trabalho_atividades plano_trabalho_atividades[]
  plano_trabalho            plano_trabalho              @relation(fields: [plano_trabalho_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plano_trabalho_id], map: "plano_trabalho_metas_plano_idx")
}

model produtos_kit_composicao {
  id                                                                           BigInt            @id @default(autoincrement())
  produto_kit_id                                                               BigInt
  produto_item_id                                                              BigInt
