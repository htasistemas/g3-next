generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Endereco {
  id                     BigInt                   @id @default(autoincrement())
  cep                    String?                  @db.VarChar(20)
  logradouro             String?                  @db.VarChar(200)
  numero                 String?                  @db.VarChar(20)
  bairro                 String?                  @db.VarChar(150)
  cidade                 String?                  @db.VarChar(150)
  estado                 String?                  @db.VarChar(2)
  criadoEm               DateTime                 @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm           DateTime                 @default(now()) @map("atualizado_em") @db.Timestamp(6)
  complemento            String?                  @db.VarChar(150)
  pontoReferencia        String?                  @map("ponto_referencia") @db.VarChar(200)
  zona                   String?                  @db.VarChar(60)
  subzona                String?                  @db.VarChar(60)
  latitude               Decimal?                 @db.Decimal(10, 6)
  longitude              Decimal?                 @db.Decimal(10, 6)
  beneficiarios          CadastroBeneficiario[]   @relation("BeneficiarioEndereco")
  cadastro_profissionais cadastro_profissionais[]
  cadastro_voluntario    cadastro_voluntario[]
  unidades               UnidadeAssistencial[]    @relation("UnidadeEndereco")

  @@map("endereco")
}

model CadastroBeneficiario {
  id                             BigInt                           @id @default(autoincrement())
  nomeCompleto                   String                           @map("nome_completo") @db.VarChar(200)
  nomeSocial                     String?                          @map("nome_social") @db.VarChar(200)
  apelido                        String?                          @db.VarChar(120)
  dataNascimento                 DateTime                         @map("data_nascimento") @db.Date
  sexoBiologico                  String?                          @map("sexo_biologico") @db.VarChar(60)
  identidadeGenero               String?                          @map("identidade_genero") @db.VarChar(120)
  corRaca                        String?                          @map("cor_raca") @db.VarChar(60)
  estadoCivil                    String?                          @map("estado_civil") @db.VarChar(60)
  nacionalidade                  String?                          @db.VarChar(120)
  naturalidadeCidade             String?                          @map("naturalidade_cidade") @db.VarChar(150)
  naturalidadeUf                 String?                          @map("naturalidade_uf") @db.VarChar(2)
  nomeMae                        String                           @map("nome_mae") @db.VarChar(200)
  nomePai                        String?                          @map("nome_pai") @db.VarChar(200)
  criadoEm                       DateTime                         @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm                   DateTime                         @default(now()) @map("atualizado_em") @db.Timestamp(6)
  enderecoId                     BigInt?                          @map("endereco_id")
  foto3x4                        String?                          @map("foto_3x4")
  codigo                         String?                          @db.VarChar(20)
  status                         String?                          @db.VarChar(60)
  optaReceberCestaBasica         Boolean?                         @map("opta_receber_cesta_basica")
  aptoReceberCestaBasica         Boolean?                         @map("apto_receber_cesta_basica")
  banco_empregos_candidatos      banco_empregos_candidatos[]
  banco_empregos_encaminhamentos banco_empregos_encaminhamentos[]
  beneficios                     BeneficiosBeneficiario[]
  biblioteca_emprestimos         biblioteca_emprestimos[]
  endereco                       Endereco?                        @relation("BeneficiarioEndereco", fields: [enderecoId], references: [id], onUpdate: NoAction)
  contatos                       ContatoBeneficiario[]
  doacao_planejada               doacao_planejada[]
  doacao_realizada               doacao_realizada[]
  documentos                     Documento[]
  escolaridades                  EscolaridadeBeneficiario[]
  observacoes                    ObservacoesBeneficiario[]
  prontuario_registros           prontuario_registros[]
  saudes                         SaudeBeneficiario[]
  senha_fila                     senha_fila[]
  situacoesSociais               SituacaoSocial[]
  familiasReferencia             VinculoFamiliar[]                @relation("ReferenciaFamiliar")
  familiasMembro                 VinculoFamiliarMembro[]          @relation("FamiliaMembroBeneficiario")
  visita_domiciliar              visita_domiciliar[]

  @@index([codigo])
  @@index([nomeCompleto], map: "cadastro_beneficiario_nome_idx")
  @@index([status])
  @@map("cadastro_beneficiario")
}

model ContatoBeneficiario {
  id                        BigInt               @id @default(autoincrement())
  beneficiarioId            BigInt               @map("beneficiario_id")
  telefonePrincipal         String?              @map("telefone_principal") @db.VarChar(30)
  telefonePrincipalWhatsapp Boolean?             @default(false) @map("telefone_principal_whatsapp")
  telefoneSecundario        String?              @map("telefone_secundario") @db.VarChar(30)
  telefoneRecadoNome        String?              @map("telefone_recado_nome") @db.VarChar(150)
  telefoneRecadoNumero      String?              @map("telefone_recado_numero") @db.VarChar(30)
  email                     String?              @db.VarChar(150)
  permiteContatoTel         Boolean?             @default(false) @map("permite_contato_tel")
  permiteContatoWhatsapp    Boolean?             @default(false) @map("permite_contato_whatsapp")
  permiteContatoSms         Boolean?             @default(false) @map("permite_contato_sms")
  permiteContatoEmail       Boolean?             @default(false) @map("permite_contato_email")
  horarioPreferencial       String?              @map("horario_preferencial_contato") @db.VarChar(80)
  criadoEm                  DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm              DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario              CadastroBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("contato_beneficiario")
}

model Documento {
  id              BigInt               @id @default(autoincrement())
  beneficiarioId  BigInt               @map("beneficiario_id")
  tipoDocumento   String?              @map("tipo_documento") @db.VarChar(80)
  numeroDocumento String?              @map("numero_documento") @db.VarChar(80)
  orgaoEmissor    String?              @map("orgao_emissor") @db.VarChar(120)
  ufEmissor       String?              @map("uf_emissor") @db.VarChar(2)
  dataEmissao     DateTime?            @map("data_emissao") @db.Date
  livro           String?              @db.VarChar(40)
  folha           String?              @db.VarChar(40)
  termo           String?              @db.VarChar(60)
  cartorio        String?              @db.VarChar(150)
  municipio       String?              @db.VarChar(150)
  uf              String?              @db.VarChar(2)
  nomeDocumento   String?              @map("nome_documento") @db.VarChar(200)
  nomeArquivo     String?              @map("nome_arquivo") @db.VarChar(200)
  caminhoArquivo  String?              @map("caminho_arquivo") @db.VarChar(400)
  contentType     String?              @map("content_type") @db.VarChar(120)
  obrigatorio     Boolean?             @default(false)
  criadoEm        DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm    DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario    CadastroBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([beneficiarioId, tipoDocumento], map: "documentos_beneficiario_tipo_idx")
  @@map("documentos")
}

model SituacaoSocial {
  id                      BigInt               @id @default(autoincrement())
  beneficiarioId          BigInt               @map("beneficiario_id")
  moraComFamilia          Boolean?             @default(false) @map("mora_com_familia")
  responsavelLegal        Boolean?             @default(false) @map("responsavel_legal")
  vinculoFamiliar         String?              @map("vinculo_familiar") @db.VarChar(150)
  situacaoVulnerabilidade String?              @map("situacao_vulnerabilidade")
  composicaoFamiliar      String?              @map("composicao_familiar")
  criancasAdolescentes    Int?                 @map("criancas_adolescentes")
  idosos                  Int?
  acompanhamentoCras      Boolean?             @default(false) @map("acompanhamento_cras")
  acompanhamentoSaude     Boolean?             @default(false) @map("acompanhamento_saude")
  participaComunidade     String?              @map("participa_comunidade") @db.VarChar(200)
  redeApoio               String?              @map("rede_apoio")
  criadoEm                DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm            DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario            CadastroBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("situacao_social")
}

model EscolaridadeBeneficiario {
  id                BigInt               @id @default(autoincrement())
  beneficiarioId    BigInt               @map("beneficiario_id")
  sabeLerEscrever   Boolean?             @default(false) @map("sabe_ler_escrever")
  nivelEscolaridade String?              @map("nivel_escolaridade") @db.VarChar(150)
  estudaAtualmente  Boolean?             @default(false) @map("estuda_atualmente")
  ocupacao          String?              @db.VarChar(150)
  situacaoTrabalho  String?              @map("situacao_trabalho") @db.VarChar(150)
  localTrabalho     String?              @map("local_trabalho") @db.VarChar(150)
  rendaMensal       String?              @map("renda_mensal") @db.VarChar(60)
  fonteRenda        String?              @map("fonte_renda") @db.VarChar(150)
  criadoEm          DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm      DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario      CadastroBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("escolaridade_beneficiario")
}

model SaudeBeneficiario {
  id                     BigInt               @id @default(autoincrement())
  beneficiarioId         BigInt               @map("beneficiario_id")
  possuiDeficiencia      Boolean?             @default(false) @map("possui_deficiencia")
  tipoDeficiencia        String?              @map("tipo_deficiencia") @db.VarChar(200)
  cidPrincipal           String?              @map("cid_principal") @db.VarChar(60)
  usaMedicacaoContinua   Boolean?             @default(false) @map("usa_medicacao_continua")
  descricaoMedicacao     String?              @map("descricao_medicacao")
  servicoSaudeReferencia String?              @map("servico_saude_referencia") @db.VarChar(200)
  criadoEm               DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm           DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario           CadastroBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("saude_beneficiario")
}

model BeneficiosBeneficiario {
  id                   BigInt               @id @default(autoincrement())
  beneficiarioId       BigInt               @map("beneficiario_id")
  recebeBeneficio      Boolean?             @default(false) @map("recebe_beneficio")
  beneficiosDescricao  String?              @map("beneficios_descricao")
  valorTotalBeneficios String?              @map("valor_total_beneficios") @db.VarChar(60)
  beneficiosRecebidos  String?              @map("beneficios_recebidos")
  criadoEm             DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm         DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario         CadastroBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("beneficios_beneficiario")
}

model ObservacoesBeneficiario {
  id             BigInt               @id @default(autoincrement())
  beneficiarioId BigInt               @map("beneficiario_id")
  aceiteLgpd     Boolean?             @default(false) @map("aceite_lgpd")
  dataAceiteLgpd DateTime?            @map("data_aceite_lgpd") @db.Date
  observacoes    String?
  criadoEm       DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm   DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario   CadastroBeneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("observacoes_beneficiario")
}

model VinculoFamiliar {
  id                           BigInt                  @id @default(autoincrement())
  nomeFamilia                  String                  @map("nome_familia") @db.VarChar(200)
  idReferenciaFamiliar         BigInt?                 @map("id_referencia_familiar")
  status                       String                  @default("ATIVO") @db.VarChar(60)
  cep                          String?                 @db.VarChar(20)
  logradouro                   String?                 @db.VarChar(200)
  numero                       String?                 @db.VarChar(20)
  complemento                  String?                 @db.VarChar(150)
  bairro                       String?                 @db.VarChar(150)
  pontoReferencia              String?                 @map("ponto_referencia") @db.VarChar(200)
  municipio                    String?                 @db.VarChar(150)
  uf                           String?                 @db.VarChar(2)
  zona                         String?                 @db.VarChar(60)
  situacaoImovel               String?                 @map("situacao_imovel") @db.VarChar(120)
  tipoMoradia                  String?                 @map("tipo_moradia") @db.VarChar(120)
  aguaEncanada                 Boolean?                @default(false) @map("agua_encanada")
  esgotoTipo                   String?                 @map("esgoto_tipo") @db.VarChar(120)
  coletaLixo                   String?                 @map("coleta_lixo") @db.VarChar(120)
  energiaEletrica              Boolean?                @default(false) @map("energia_eletrica")
  internet                     Boolean?                @default(false)
  arranjoFamiliar              String?                 @map("arranjo_familiar") @db.VarChar(200)
  qtdMembros                   Int?                    @map("qtd_membros")
  qtdCriancas                  Int?                    @map("qtd_criancas")
  qtdAdolescentes              Int?                    @map("qtd_adolescentes")
  qtdIdosos                    Int?                    @map("qtd_idosos")
  qtdPessoasDeficiencia        Int?                    @map("qtd_pessoas_deficiencia")
  rendaFamiliarTotal           String?                 @map("renda_familiar_total") @db.VarChar(60)
  rendaPerCapita               String?                 @map("renda_per_capita") @db.VarChar(60)
  faixaRendaPerCapita          String?                 @map("faixa_renda_per_capita") @db.VarChar(120)
  principaisFontesRenda        String?                 @map("principais_fontes_renda")
  situacaoInsegurancaAlimentar String?                 @map("situacao_inseguranca_alimentar")
  possuiDividasRelevantes      Boolean?                @default(false) @map("possui_dividas_relevantes")
  descricaoDividas             String?                 @map("descricao_dividas")
  vulnerabilidadesFamilia      String?                 @map("vulnerabilidades_familia")
  servicosAcompanhamento       String?                 @map("servicos_acompanhamento")
  tecnicoResponsavel           String?                 @map("tecnico_responsavel") @db.VarChar(150)
  periodicidadeAtendimento     String?                 @map("periodicidade_atendimento") @db.VarChar(120)
  proximaVisitaPrevista        DateTime?               @map("proxima_visita_prevista") @db.Date
  observacoes                  String?
  criadoEm                     DateTime                @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm                 DateTime                @default(now()) @map("atualizado_em") @db.Timestamp(6)
  doacao_planejada             doacao_planejada[]
  doacao_realizada             doacao_realizada[]
  prontuario_registros         prontuario_registros[]
  referenciaFamiliar           CadastroBeneficiario?   @relation("ReferenciaFamiliar", fields: [idReferenciaFamiliar], references: [id], onUpdate: NoAction)
  membros                      VinculoFamiliarMembro[]

  @@index([nomeFamilia], map: "vinculo_familiar_nome_idx")
  @@map("vinculo_familiar")
}

model VinculoFamiliarMembro {
  id                  BigInt               @id @default(autoincrement())
  vinculoFamiliarId   BigInt               @map("vinculo_familiar_id")
  beneficiarioId      BigInt               @map("beneficiario_id")
  parentesco          String?              @db.VarChar(120)
  responsavelFamiliar Boolean?             @default(false) @map("responsavel_familiar")
  contribuiRenda      Boolean?             @default(false) @map("contribui_renda")
  rendaIndividual     String?              @map("renda_individual") @db.VarChar(60)
  participaServicos   Boolean?             @default(false) @map("participa_servicos")
  observacoes         String?
  usaEnderecoFamilia  Boolean?             @default(true) @map("usa_endereco_familia")
  criadoEm            DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm        DateTime             @default(now()) @map("atualizado_em") @db.Timestamp(6)
  beneficiario        CadastroBeneficiario @relation("FamiliaMembroBeneficiario", fields: [beneficiarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vinculoFamiliar     VinculoFamiliar      @relation(fields: [vinculoFamiliarId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("vinculo_familiar_membro")
}

model UnidadeAssistencial {
  id                        BigInt                 @id @default(autoincrement())
  nomeFantasia              String                 @map("nome_fantasia") @db.VarChar(200)
  razaoSocial               String?                @map("razao_social") @db.VarChar(200)
  cnpj                      String?                @db.VarChar(20)
  email                     String?                @db.VarChar(150)
  telefone                  String?                @db.VarChar(30)
  horario_funcionamento     String?                @db.VarChar(120)
  observacoes               String?
  criadoEm                  DateTime               @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm              DateTime               @default(now()) @map("atualizado_em") @db.Timestamp(6)
  unidadePrincipal          Boolean                @default(false) @map("unidade_principal")
  enderecoId                BigInt?                @map("endereco_id")
  site                      String?                @db.VarChar(200)
  raio_ponto_metros         Int                    @default(100)
  accuracy_max_ponto_metros Int                    @default(80)
  ip_validacao_ponto        String?                @db.VarChar(45)
  ping_timeout_ms           Int                    @default(2000)
  ips_publicos_ponto        String?
  redes_locais_ponto        String?
  modo_validacao_ponto      String                 @default("IP_OU_REDE") @db.VarChar(30)
  diretoria_unidade         diretoria_unidade[]
  emprestimos_eventos       emprestimos_eventos[]
  fotos_eventos             fotos_eventos[]
  imagens_unidade           imagens_unidade?
  oficios                   oficios[]
  prontuario_registros      prontuario_registros[]
  salas_unidade             salas_unidade[]
  senha_chamada             senha_chamada[]
  senha_config              senha_config[]
  senha_fila                senha_fila[]
  transparencia             transparencia[]
  endereco                  Endereco?              @relation("UnidadeEndereco", fields: [enderecoId], references: [id], onUpdate: NoAction)

  @@map("unidade_assistencial")
}

