model senha_fila {
  id                    BigInt               @id @default(autoincrement())
  beneficiario_id       BigInt
  status                String               @db.VarChar(20)
  prioridade            Int                  @default(0)
  data_hora_entrada     DateTime             @default(now()) @db.Timestamp(6)
  data_hora_atualizacao DateTime             @default(now()) @db.Timestamp(6)
  unidade_id            BigInt?
  usuario_id            BigInt?
  sala_atendimento      String?              @db.VarChar(120)
  senha_chamada         senha_chamada[]
  cadastro_beneficiario CadastroBeneficiario @relation(fields: [beneficiario_id], references: [id], onUpdate: NoAction)
  unidade_assistencial  UnidadeAssistencial? @relation(fields: [unidade_id], references: [id], onUpdate: NoAction)
  usuarios              Usuario?             @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([status, prioridade(sort: Desc), data_hora_entrada], map: "senha_fila_prioridade_data_idx")
  @@index([status])
  @@index([unidade_id], map: "senha_fila_unidade_idx")
}

