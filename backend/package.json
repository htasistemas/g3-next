{
  "name": "g3n-backend-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/start-with-migrations.ts",
    "build": "tsc -p tsconfig.node.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "test:educacional": "tsx --test src/modules/educacional/__tests__/educacional.schema.test.ts",
    "test:text": "tsx --test src/config/__tests__/google-client-ids.test.ts src/utils/__tests__/text-formatter.test.ts src/modules/__tests__/text-normalization.integration.test.ts src/modules/auth/__tests__/auth.schema.test.ts src/modules/arquivos/services/__tests__/storage-utils.test.ts src/modules/backup-sistema/__tests__/backup-sistema.service.test.ts src/modules/beneficiarios/__tests__/beneficiario.schema.test.ts src/modules/controle-veiculos/__tests__/controle-veiculos.schema.test.ts src/modules/autorizacao-compras/__tests__/autorizacao-compras.workflow.test.ts src/modules/contabilidade/__tests__/contabilidade.workflow.test.ts src/modules/documentos-instituicao/__tests__/documentos-instituicao.utils.test.ts src/modules/documentos-instituicao/__tests__/documentos-instituicao.alertas.test.ts src/modules/captacao-recursos/__tests__/captacao-recursos.schema.test.ts src/modules/ai/services/__tests__/ai-history-sanitizer.test.ts src/modules/planos-trabalho/__tests__/planos-trabalho.utils.test.ts src/modules/patrimonios/__tests__/patrimonio.schema.test.ts src/modules/registro-ponto/__tests__/registro-ponto-hora-extra.schema.test.ts src/modules/registro-ponto/__tests__/registro-ponto-calculos.test.ts src/modules/voluntarios/__tests__/voluntario-escala.schema.test.ts src/modules/matriculas/__tests__/matricula-presenca.test.ts src/modules/reports/__tests__/matricula-frequencia.test.ts src/modules/doacoes-realizadas/__tests__/doacao-realizada-erros.test.ts",
    "normalize:text": "tsx scripts/normalize-text-data.ts",
    "normalize:text:dry-run": "tsx scripts/normalize-text-data.ts --dry-run",
    "normalize:beneficiarios": "tsx scripts/normalize-text-data.ts --tables=cadastro_beneficiario,contato_beneficiario",
    "normalize:beneficiarios:dry-run": "tsx scripts/normalize-text-data.ts --dry-run --tables=cadastro_beneficiario,contato_beneficiario",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "dev:seed-admin": "tsx scripts/seed-dev-admin.ts",
    "g3n:base": "tsx scripts/preparar-tenant-apresentacao.ts",
    "storage:migrate-tenants": "tsx scripts/migrar-storage-tenant.ts",
    "storage:migrate-tenants:dry-run": "tsx scripts/migrar-storage-tenant.ts --dry-run",
    "storage:cleanup-missing": "tsx scripts/limpar-arquivos-sem-fisico.ts",
    "storage:cleanup-missing:dry-run": "tsx scripts/limpar-arquivos-sem-fisico.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.6.0",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^5.0.0",
    "pdfkit": "^0.15.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.2",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
