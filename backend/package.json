{
  "name": "g3-backend-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.node.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "test:text": "tsx --test src/utils/__tests__/text-formatter.test.ts src/modules/__tests__/text-normalization.integration.test.ts",
    "normalize:text": "tsx scripts/normalize-text-data.ts",
    "normalize:text:dry-run": "tsx scripts/normalize-text-data.ts --dry-run",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "dev:seed-admin": "tsx scripts/seed-dev-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.15.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.2",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
